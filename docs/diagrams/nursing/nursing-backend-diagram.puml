@startuml
' Bounded Context: nursing
' Compact view: aggregates, services, repositories, controllers.
' Individual commands/queries/resources/assemblers are omitted for readability.

left to right direction
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  ArrowColor #444444
  BorderColor #333333
}

package "domain.model.aggregates" {
  class NursingHome {
    +NursingHomeId id
    +BusinessProfileId businessProfileId
    +Administrator administrator
    +Rooms rooms
  }
  class Resident {
    +ResidentId id
    +PersonProfileId profileId
    +ResidentState status
    +EmergencyContact emergencyContact
    +LegalRepresentative legalRepresentative
  }
  class Medication {
    +MedicationId id
    +String name
    +DrugPresentation drugPresentation
    +Stock stock
  }
  class Administrator {
    +UserId userId
  }
  class Relative {
    +UserId userId
    +EmailAddress emailAddress
    +PersonName personName
    +Resident resident
    +NursingHome nursingHome
  }
}

package "domain.model.entities" {
  class Room {
    +RoomId id
    +int roomNumber
    +RoomOccupancy capacity
    +RoomStatus status
  }
}

package "domain.model.events" {
  class AdmittedResidentEvent
  class MedicationStockLowEvent
  class RegisteredRelativeEvent
  class RetiredResidentEvent
}

package "domain.services" {
  interface AdministratorCommandService
  interface AdministratorQueryService
  interface MedicationCommandServices
  interface MedicationQueryServices
  interface NursingHomeCommandServices
  interface NursingHomeQueryServices
  interface RelativeCommandService
  interface RelativeQueryService
  interface ResidentCommandServices
  interface ResidentQueryServices
}

package "application.internal (command/query services)" {
  class AdministratorCommandServiceImpl
  class AdministratorQueryServiceImpl
  class MedicationCommandServicesImpl
  class MedicationQueryServiceImpl
  class NursingHomeCommandServiceImpl
  class NursingHomeQueryServiceImpl
  class RelativeCommandServiceImpl
  class RelativeQueryServiceImpl
  class ResidentCommandServiceImpl
  class ResidentQueryServiceImpl
}

package "application.internal.eventhandlers" {
  class RegisteredRelativeEventHandler
}

package "application.outboundservices.acl" {
  class ExternalIamService
  class ExternalProfileService
  class ExternalCommunicationService
  class ExternalHcmService
}

package "infrastructure.persistence.jpa.repositories" {
  interface AdministratorRepository
  interface MedicationRepository
  interface NursingHomeRepository
  interface RelativeRepository
  interface ResidentRepository
  interface RoomRepository
}

package "application.acl / interfaces.acl" {
  interface NursingContextFacade
  class NursingContextFacadeImpl
}

package "interfaces.rest" {
  class AdministratorsController
  class AdministratorNursingHomesController
  class MedicationsController
  class NursingHomeRelativesController
  class NursingHomeResidentsController
  class NursingHomeRoomsController
  class NursingHomesController
  class RelativeResidentsController
  class ResidentMedicationsController
  class ResidentsController
}

' Aggregate relationships
NursingHome *-- Room : "has 0..*"
NursingHome *-- Resident : "hosts 0..*"
NursingHome --> Administrator : "administrator_id (ManyToOne)"
NursingHome *-- Relative : "0..*"
Resident o-- Room : "assigned to 0..1"
Resident *-- Medication : "receives 0..*"
Relative "1" -- "1" Resident : "resident_id (OneToOne)"

' Repositories -> Aggregates
MedicationRepository --> Medication
NursingHomeRepository --> NursingHome
ResidentRepository --> Resident
RoomRepository --> Room
AdministratorRepository --> Administrator
RelativeRepository --> Relative

' Service interfaces -> Implementations
MedicationCommandServices <|.. MedicationCommandServicesImpl
MedicationQueryServices <|.. MedicationQueryServiceImpl
NursingHomeCommandServices <|.. NursingHomeCommandServiceImpl
NursingHomeQueryServices <|.. NursingHomeQueryServiceImpl
ResidentCommandServices <|.. ResidentCommandServiceImpl
ResidentQueryServices <|.. ResidentQueryServiceImpl
AdministratorCommandService <|.. AdministratorCommandServiceImpl
AdministratorQueryService <|.. AdministratorQueryServiceImpl
RelativeCommandService <|.. RelativeCommandServiceImpl
RelativeQueryService <|.. RelativeQueryServiceImpl

' Implementations use repositories and outbound services
MedicationCommandServicesImpl --> MedicationRepository
MedicationQueryServiceImpl --> MedicationRepository

NursingHomeCommandServiceImpl --> NursingHomeRepository
NursingHomeCommandServiceImpl --> RoomRepository
NursingHomeCommandServiceImpl --> ExternalProfileService
NursingHomeQueryServiceImpl --> NursingHomeRepository
NursingHomeQueryServiceImpl --> AdministratorRepository : findByAdministratorId

ResidentCommandServiceImpl --> ResidentRepository
ResidentCommandServiceImpl --> NursingHomeRepository
ResidentCommandServiceImpl --> ExternalProfileService
ResidentQueryServiceImpl --> ResidentRepository
ResidentQueryServiceImpl --> RelativeRepository : resolves relative's resident

AdministratorCommandServiceImpl --> AdministratorRepository
AdministratorCommandServiceImpl --> ExternalIamService : creates IAM user (ROLE_ADMIN)
AdministratorQueryServiceImpl --> AdministratorRepository

RelativeCommandServiceImpl --> RelativeRepository
RelativeCommandServiceImpl --> NursingHomeRepository
RelativeCommandServiceImpl --> ResidentRepository
RelativeQueryServiceImpl --> RelativeRepository

' Controllers use services
MedicationsController --> MedicationCommandServices
MedicationsController --> MedicationQueryServices
ResidentsController --> ResidentCommandServices
ResidentsController --> ResidentQueryServices
ResidentMedicationsController --> MedicationCommandServices
ResidentMedicationsController --> MedicationQueryServices
NursingHomesController --> NursingHomeCommandServices
NursingHomesController --> NursingHomeQueryServices
NursingHomeResidentsController --> ResidentQueryServices
NursingHomeRoomsController --> RoomRepository
AdministratorsController --> AdministratorCommandService
AdministratorsController --> AdministratorQueryService
AdministratorNursingHomesController --> NursingHomeCommandServices
AdministratorNursingHomesController --> NursingHomeQueryServices
NursingHomeRelativesController --> RelativeCommandService
NursingHomeRelativesController --> RelativeQueryService
NursingHomeRelativesController --> NursingHomeQueryServices
RelativeResidentsController --> ResidentQueryServices
RelativeResidentsController --> RelativeCommandService

' Events and handlers
AdmittedResidentEvent ..> ResidentCommandServiceImpl : triggers
MedicationStockLowEvent ..> MedicationCommandServicesImpl : alerts
RetiredResidentEvent ..> ResidentCommandServiceImpl : triggers

Relative --> RegisteredRelativeEvent : raises (on registration)
RegisteredRelativeEventHandler --> RegisteredRelativeEvent : listens (async)
RegisteredRelativeEventHandler --> ExternalIamService : creates relative IAM account
RegisteredRelativeEventHandler --> RelativeCommandService : handle(AssignUserToRelativeCommand)
RegisteredRelativeEventHandler --> ExternalCommunicationService : sends activation email

' ACL facade usage
NursingContextFacadeImpl ..|> NursingContextFacade
NursingContextFacadeImpl --> ResidentCommandServiceImpl
NursingContextFacadeImpl --> NursingHomeQueryServiceImpl
NursingContextFacadeImpl --> MedicationCommandServicesImpl

@enduml
