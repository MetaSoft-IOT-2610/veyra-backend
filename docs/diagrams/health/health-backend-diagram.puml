@startuml
' Bounded Context: health
' Compact view: aggregates, services, repositories, controllers.
' Individual commands/queries/resources/assemblers are omitted for readability.

left to right direction
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 50
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  ArrowColor #444444
  BorderColor #333333
}

package "domain.model.aggregates" {
  class Allergy {
    +residentId : ResidentId
    +reaction : String
    +allergenName : String
    +typeOfAllergy : TypeOfAllergy
    +severityLevel : SeverityLevel
  }
  class VitalSign {
    +residentId : ResidentId
    +measurementId : MeasurementId
    +severityLevel : SeverityLevel
    +heartRate : Integer
    +systolic : Integer
    +diastolic : Integer
    +temperature : Double
    +oxygenSaturation : Integer
    +respiratoryRate : Integer
    +registeredAt : LocalDateTime
  }
  class MedicalCondition {
    +residentId : ResidentId
    +diagnosisName : String
    +diagnosisDate : LocalDate
    +status : DiagnosisStatus
    +notes : String
  }
  class VitalSignThreshold {
    +residentId : ResidentId
    +heartRateMin/Max : Integer
    +systolicMax : Integer
    +diastolicMax : Integer
    +temperatureMin/Max : Double
    +oxygenSaturationMin/Max : Integer
    +respiratoryRateMin/Max : Integer
  }
}

package "domain.model.events" {
  class AbnormalVitalSignDetectedEvent
}

package "domain.services" {
  interface AllergyCommandService
  interface AllergyQueryService
  interface VitalSignCommandService
  interface VitalSignQueryService
  interface MedicalConditionCommandService
  interface MedicalConditionQueryService
  interface VitalSignThresholdCommandService
  interface VitalSignThresholdQueryService
}

package "application.internal (command/query services)" {
  class AllergyCommandServiceImpl
  class AllergyQueryServiceImpl
  class VitalSignCommandServiceImpl
  class VitalSignQueryServiceImpl
  class MedicalConditionCommandServiceImpl
  class MedicalConditionQueryServiceImpl
  class VitalSignThresholdCommandServiceImpl
  class VitalSignThresholdQueryServiceImpl
}

package "application.internal.eventhandlers" {
  class AbnormalVitalSignDetectedEventHandler
  class MeasurementRecordedEventHandler
}

package "application.internal.outboundservices.acl" {
  class ExternalNursingService
  class ExternalTrackingService
  class ExternalCommunicationService
  class ExternalHcmService
}

package "infrastructure.persistence.jpa.repositories" {
  interface AllergyRepository
  interface VitalSignRepository
  interface MedicalConditionRepository
  interface VitalSignThresholdRepository
}

package "interfaces.rest" {
  class ResidentAllergiesController
  class VitalSignsController
  class ResidentMedicalConditionsController
  class ResidentVitalSignThresholdsController
  class EdgeVitalSignThresholdsController
}

AllergyRepository --> Allergy
VitalSignRepository --> VitalSign
MedicalConditionRepository --> MedicalCondition
VitalSignThresholdRepository --> VitalSignThreshold

AllergyCommandService <|.. AllergyCommandServiceImpl
AllergyQueryService <|.. AllergyQueryServiceImpl
VitalSignCommandService <|.. VitalSignCommandServiceImpl
VitalSignQueryService <|.. VitalSignQueryServiceImpl
MedicalConditionCommandService <|.. MedicalConditionCommandServiceImpl
MedicalConditionQueryService <|.. MedicalConditionQueryServiceImpl
VitalSignThresholdCommandService <|.. VitalSignThresholdCommandServiceImpl
VitalSignThresholdQueryService <|.. VitalSignThresholdQueryServiceImpl

AllergyCommandServiceImpl --> AllergyRepository
AllergyQueryServiceImpl --> AllergyRepository
VitalSignCommandServiceImpl --> VitalSignRepository
VitalSignQueryServiceImpl --> VitalSignRepository
MedicalConditionCommandServiceImpl --> MedicalConditionRepository
MedicalConditionQueryServiceImpl --> MedicalConditionRepository
VitalSignThresholdCommandServiceImpl --> VitalSignThresholdRepository
VitalSignThresholdQueryServiceImpl --> VitalSignThresholdRepository

' Cross-context lookups
MedicalConditionCommandServiceImpl --> ExternalNursingService : validates resident exists

' Vital sign anomaly detection reads configured thresholds
VitalSignCommandServiceImpl --> VitalSignThresholdQueryService : reads
VitalSignCommandServiceImpl --> ExternalTrackingService

AbnormalVitalSignDetectedEventHandler --> AbnormalVitalSignDetectedEvent
AbnormalVitalSignDetectedEventHandler --> ExternalNursingService
AbnormalVitalSignDetectedEventHandler --> ExternalTrackingService

' Tracking measurements feed the health vital-sign validation flow
MeasurementRecordedEventHandler --> VitalSignCommandService : handle(ValidateVitalSignCommand)

ResidentAllergiesController --> AllergyCommandService
ResidentAllergiesController --> AllergyQueryService

VitalSignsController --> VitalSignCommandService
VitalSignsController --> VitalSignQueryService

ResidentMedicalConditionsController --> MedicalConditionCommandService
ResidentMedicalConditionsController --> MedicalConditionQueryService

ResidentVitalSignThresholdsController --> VitalSignThresholdCommandService
ResidentVitalSignThresholdsController --> VitalSignThresholdQueryService

EdgeVitalSignThresholdsController --> VitalSignThresholdRepository : reads directly

@enduml
